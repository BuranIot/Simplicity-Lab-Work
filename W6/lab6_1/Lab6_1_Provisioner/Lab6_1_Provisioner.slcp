# Silicon Labs Project Configuration Tools: slcp, v0, Component selection file.
project_name: Lab6_1_Provisioner
label: Lab6_1_Provisioner
description: |
  Demonstrates the bare minimum needed for a Bluetooth Mesh C application. The application starts Unprovisioned Device Beaconing after booting, and then waits to be provisioned.
category: Bluetooth Mesh Examples
filter:
- name: Device Type
  value: [SoC]
- name: Project Difficulty
  value: [Beginner]
- name: Wireless Technology
  value: [Bluetooth Mesh]
package: Btmesh
quality: production
readme:
- {path: readme.md}
- {path: readme.md}
source:
- {path: app.c}
- {path: app_bm.c}
tag: ['hardware:rf:band:2400', 'hardware:device:flash:512', 'hardware:device:ram:32']
include:
- path: .
  file_list:
  - {path: app.h}
sdk: {id: simplicity_sdk, version: 2025.6.3}
toolchain_settings: []
component:
- {id: EFR32MG21A020F1024IM32}
- {id: app_assert}
- {id: app_button_press}
- {id: app_log}
- {id: bootloader_interface}
- {id: brd4180b}
- {id: bt_post_build}
- {id: btmesh_factory_reset}
- {id: btmesh_proxy}
- {id: btmesh_stack_config_client}
- {id: btmesh_stack_gatt_prov_bearer}
- {id: btmesh_stack_provisioner}
- {id: btmesh_stack_relay}
- {id: btmesh_stack_test}
- {id: btmesh_stack_vendor_model}
- {id: btmesh_wstk_lcd}
- {id: clock_manager}
- {id: device_init}
- instance: [vcom]
  id: iostream_usart
- {id: mpu}
- {id: rail_util_pti}
- {id: sl_main}
other_file:
- {path: readme_img0.png}
- {path: readme_img1.png}
- {path: readme_img2.png}
- {path: readme_img3.png}
- {path: readme_img4.png}
- {path: readme_img5.png}
configuration:
- {name: EMDRV_DMADRV_DMA_CH_COUNT, value: '2'}
- {name: NVM3_DEFAULT_NVM_SIZE, value: '0x6000'}
- {name: SL_BTMESH_CONFIG_MAX_PROV_BEARERS, value: '3'}
- condition: [psa_crypto]
  name: SL_PSA_KEY_USER_SLOT_COUNT
  value: '0'
- {name: SL_STACK_SIZE, value: '0x1200'}
ui_hints:
  highlight:
  - {path: config/btconf/gatt_configuration.btconf}
  - {path: config/btmeshconf/dcd_config.btmeshconf}
  - {path: readme.md, focus: true}
post_build:
- {path: Lab6_1_Provisioner.slpb, profile: btmesh_common}

